# Required: at least 32 characters. Used to derive payload keys and signatures.
MASTER_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional allowlists (comma separated). Empty = allow all valid-format ids.
BUILDS=
MACHINES=

# Key lifetime in seconds
KEY_TTL=300

# Requests per minute per IP
RATE_LIMIT=30
